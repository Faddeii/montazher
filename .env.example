# Скопируйте этот файл в .env и впишите свой ключ.
# Ключ: https://console.anthropic.com/settings/keys
# Необязательно: без ключа всё работает, дубли и оговорки ищутся упрощённым локальным поиском.
ANTHROPIC_API_KEY=

# Модель Claude и глубина анализа (low / medium / high)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Модель распознавания: large-v3-turbo (быстро), large-v3 (точнее, медленнее)
WHISPER_MODEL=large-v3-turbo
# auto — видеокарта NVIDIA, если есть; cuda — только видеокарта; cpu — только процессор (медленнее)
WHISPER_DEVICE=auto
LANGUAGE=ru

PORT=8765

# Папка проектов CapCut, если вы меняли её в настройках CapCut
# CAPCUT_DRAFTS=C:/Users/Имя/AppData/Local/CapCut/User Data/Projects/com.lveditor.draft

# Если huggingface.co у вас не открывается и модель не скачивается — зеркало для скачивания модели
# HF_ENDPOINT=https://hf-mirror.com
